{
  "expo": {
    "name": "HtoGestão",
    "slug": "hto-gestao",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#14532d"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.htogestao.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#14532d"
      },
      "package": "com.htogestao.app"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-print",
        { "isFaceID": true }
      ]
    ],
    "scheme": "htogestao",
    "experiments": {
      "typedRoutes": true
    }
  }
}
